{
  "name": "guayabera-cad",
  "version": "1.0.0",
  "description": "CAD software for traditional Yucatecan Guayabera design and production",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "keywords": ["guayabera", "cad", "textile", "fashion", "pattern"],
  "author": "GuayaberaCAD Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "dxf": "^4.1.2",
    "qrcode": "^1.5.3",
    "crypto": "^1.0.1"
  },
  "build": {
    "appId": "com.guayabera.cad",
    "productName": "GuayaberaCAD",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  }
}
